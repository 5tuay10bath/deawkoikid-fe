{
  "name": "property-management-cypress-tests",
  "version": "1.0.0",
  "description": "Comprehensive Cypress E2E test suite for Property Management System",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headless": "cypress run --headless",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:edge": "cypress run --browser edge",
    "test:e2e": "cypress run",
    "test:e2e:headed": "cypress run --headed",
    "test:component": "cypress run --component",
    "test:tenant-management": "cypress run --spec 'cypress/e2e/property-management/tenant-management/**/*'",
    "test:dashboard": "cypress run --spec 'cypress/e2e/property-management/dashboard/**/*'",
    "test:receipts-contracts": "cypress run --spec 'cypress/e2e/property-management/receipts-contracts/**/*'",
    "test:maintenance": "cypress run --spec 'cypress/e2e/property-management/maintenance/**/*'",
    "test:smoke": "cypress run --spec 'cypress/e2e/property-management/smoke/**/*'",
    "test:parallel": "cypress run --record --parallel",
    "test:ci": "cypress run --record --key $CYPRESS_RECORD_KEY",
    "test:dashboard:open": "cypress open --config specPattern='cypress/e2e/property-management/dashboard/**/*'",
    "test:tenants:open": "cypress open --config specPattern='cypress/e2e/property-management/tenant-management/**/*'",
    "test:maintenance:open": "cypress open --config specPattern='cypress/e2e/property-management/maintenance/**/*'",
    "test:receipts:open": "cypress run --spec 'cypress/e2e/property-management/receipts-contracts/**/*' --headed",
    "test:debug": "cypress open --config watchForFileChanges=true",
    "test:mobile": "cypress run --config viewportWidth=375,viewportHeight=667",
    "test:tablet": "cypress run --config viewportWidth=768,viewportHeight=1024",
    "test:desktop": "cypress run --config viewportWidth=1920,viewportHeight=1080",
    "report:generate": "cypress run --reporter mochawesome --reporter-options reportDir=cypress/reports,overwrite=false,html=true,json=true",
    "report:merge": "mochawesome-merge cypress/reports/*.json > cypress/reports/merged-report.json",
    "report:html": "marge cypress/reports/merged-report.json --reportDir cypress/reports --inline",
    "clean:reports": "rm -rf cypress/reports cypress/screenshots cypress/videos",
    "clean:windows": "rmdir /s /q cypress\\reports cypress\\screenshots cypress\\videos",
    "lint:cypress": "eslint cypress/**/*.js",
    "format:cypress": "prettier --write cypress/**/*.js"
  },
  "devDependencies": {
    "cypress": "^13.6.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}